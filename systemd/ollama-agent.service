[Unit]
Description=Ollama SRE Telemetry & Alert Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/sre-agent/environment
ExecStart=/bin/sh -c 'cd "$SRE_AGENT_DIR" && PYTHONPATH="$SRE_AGENT_DIR/src" exec /usr/bin/python3 -m sre_agent'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target