[Unit]
Description=Ollama SRE Telegram Command Bot
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/sre-agent/environment
ExecStart=/bin/sh -c 'cd "$SRE_AGENT_DIR" && PYTHONPATH="$SRE_AGENT_DIR/src" exec /usr/bin/python3 -m sre_agent --telegram-bot'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
